# ============================================================
# TeknoHub — Environment Variables
# Salin ke .env.local (apps/web) untuk dev, atau set di Vercel
# JANGAN commit secret asli ke git! Isi nilai placeholder sendiri.
# ============================================================

# --- Supabase Storage & Auth ---
# Ambil dari: https://supabase.com/dashboard → project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[project-id].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[Supabase → Settings → API → anon key]
SUPABASE_SERVICE_ROLE_KEY=[Supabase → Settings → API → service_role key]

# --- NextAuth Configuration ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=[generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"]

# --- Google OAuth Credentials ---
# Ambil dari: https://console.cloud.google.com → Credentials
GOOGLE_CLIENT_ID=[Google Cloud Console → Credentials → Client ID]
GOOGLE_CLIENT_SECRET=[Google Cloud Console → Credentials → Client Secret]

# --- Midtrans Payment Gateway ---
# Sandbox key dari https://dashboard.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=SB-Mid-server-[Sandbox Server Key]
MIDTRANS_CLIENT_KEY=SB-Mid-client-[Sandbox Client Key]
# Prefix NEXT_PUBLIC_ dibutuhkan route client (dipakai di CheckoutForm)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-[Sandbox Client Key]

# --- Local Ollama AI Engine ---
# LLM lokal jalan di localhost:11434 (jalankan: ollama serve)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# --- Cron Auth (Vercel Cron / update harga) ---
# Dipakai route /api/cron/update-prices — header Authorization = CRON_SECRET
CRON_SECRET=[generate: openssl rand -hex 32]

# --- Application Metadata ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TeknoZone