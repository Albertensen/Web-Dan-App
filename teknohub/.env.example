# ============================================================
# TeknoHub — Environment Variables
# Salin ke .env.local (apps/web) untuk dev, atau set di Vercel
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=<isi-dari-supabase-dashboard>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<isi-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<isi-secret-key-server-only>

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TeknoHub

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-dengan-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Midtrans (Fase 2) ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
